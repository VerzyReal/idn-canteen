# ── Environment Variables IDN Canteen ──────────────────────────
# Salin file ini menjadi .env (untuk Prisma CLI & Next.js)
# JANGAN commit file .env atau .env.local ke git!

# ── Database (PostgreSQL / Supabase / Neon) ───────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/idn_canteen?schema=public"

# ── JWT Auth Secret ───────────────────────────────────────────
JWT_SECRET="GANTI_DENGAN_RANDOM_STRING_PANJANG_32_KARAKTER_MINIMUM"

# ── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="IDN Canteen"
